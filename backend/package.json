    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
